{
  "name": "bunbook",
  "displayName": "BunBook",
  "description": "Run TypeScript as a native VS Code notebook with Plotly support",
  "version": "1.2.2",
  "publisher": "DavidBuezas",
  "license": "MIT",
  "repository": "https://github.com/dbuezas/bunbook",
  "keywords": [
    "typescript",
    "notebook",
    "jupyter",
    "bun",
    "plotly",
    "interactive",
    "notebookKernelJupyterNotebook"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "notebooks": [
      {
        "type": "bunbook",
        "displayName": "BunBook — TypeScript (Bun), outputs not saved",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.no-output.ipynb"
          },
          {
            "filenamePattern": "*.bunbook"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "bunbook-typescript",
        "aliases": [
          "TypeScript (BunBook)"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bunbook-typescript",
        "scopeName": "source.ts.bunbook",
        "path": "./syntaxes/bunbook-typescript.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "tokenTypes": {
          "punctuation.definition.template-expression": "other",
          "entity.name.type.instance.jsdoc": "other",
          "entity.name.function.tagged-template": "other",
          "meta.import string.quoted": "other",
          "variable.other.jsdoc": "other"
        }
      }
    ],
    "configuration": {
      "title": "BunBook",
      "properties": {
        "bunbook.useTsconfig": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Use a tsconfig.json for notebook intellisense (compiler options, `paths`, `types`, etc.). When disabled, BunBook's built-in compiler options are used."
        },
        "bunbook.tsconfigPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to the `tsconfig.json` used for notebook intellisense. Absolute, or relative to the workspace folder. When empty, the nearest `tsconfig.json` in the notebook's directory or its parents is used."
        }
      }
    },
    "commands": [
      {
        "command": "bunbook.restartKernel",
        "title": "Restart Kernel",
        "shortTitle": "Restart",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bunbook.enableSaveOutputs",
        "title": "BunBook: Enable saving outputs to file",
        "shortTitle": "BunBook: Enable saving outputs",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "bunbook.disableSaveOutputs",
        "title": "BunBook: Disable saving outputs to file",
        "shortTitle": "BunBook: Disable saving outputs",
        "icon": "$(pass-filled)"
      },
      {
        "command": "bunbook.exportToTypeScript",
        "title": "BunBook: Export to TypeScript File"
      },
      {
        "command": "bunbook.importFromTypeScript",
        "title": "BunBook: Import from TypeScript File"
      },
      {
        "command": "bunbook.exportToHtml",
        "title": "BunBook: Export to HTML"
      },
      {
        "command": "bunbook.exportToMarkdown",
        "title": "BunBook: Export to Markdown"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "bunbook.restartKernel",
          "group": "navigation/execute@1",
          "when": "(notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller') && bunbook.hasWorker"
        },
        {
          "command": "bunbook.enableSaveOutputs",
          "group": "bunbook@1",
          "when": "(notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller') && !bunbook.persistOutputs"
        },
        {
          "command": "bunbook.disableSaveOutputs",
          "group": "bunbook@1",
          "when": "(notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller') && bunbook.persistOutputs"
        },
        {
          "command": "bunbook.exportToTypeScript",
          "group": "bunbook@2",
          "when": "notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller'"
        },
        {
          "command": "bunbook.importFromTypeScript",
          "group": "bunbook@3",
          "when": "notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller'"
        },
        {
          "command": "bunbook.exportToHtml",
          "group": "bunbook@4",
          "when": "notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller'"
        },
        {
          "command": "bunbook.exportToMarkdown",
          "group": "bunbook@5",
          "when": "notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller'"
        }
      ],
      "commandPalette": [
        {
          "command": "bunbook.enableSaveOutputs",
          "when": "(notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller') && !bunbook.persistOutputs"
        },
        {
          "command": "bunbook.disableSaveOutputs",
          "when": "(notebookType == 'bunbook' || notebookKernel == 'DavidBuezas.bunbook/bunbook-jupyter-controller') && bunbook.persistOutputs"
        }
      ]
    },
    "notebookRenderer": [
      {
        "id": "bunbook-plotly-renderer",
        "displayName": "Plotly Renderer",
        "entrypoint": "./out/renderer/index.js",
        "mimeTypes": [
          "application/vnd.bunbook.plotly"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun build.ts --production",
    "compile": "bun build.ts",
    "start": "rm -f bunbook-*.vsix && vsce package && code --install-extension bunbook-*.vsix && say done",
    "publish": "vsce publish",
    "test": "bun test"
  },
  "dependencies": {
    "@types/bun": "^1.3.10",
    "@types/plotly.js": "^3.0.10"
  },
  "packageManager": "bun@1.3.10",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-notebook-renderer": "^1.72.3",
    "@vscode/vsce": "^3.7.1",
    "acorn": "^8.16.0",
    "astring": "^1.9.0",
    "typescript": "^5.3.0"
  }
}
